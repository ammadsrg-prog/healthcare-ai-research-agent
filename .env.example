# Copy this file to ".env" and fill in your own values.
# The .env file stays on your computer and is never shared.

# Free key from https://openalex.org/settings/api-key
# Recommended: without a key, OpenAlex often blocks searches with "429 Too Many Requests".
OPENALEX_API_KEY=

# The AWS region where you will use Amazon Bedrock
AWS_REGION=us-east-1

# Which AI model to use on Bedrock
BEDROCK_MODEL_ID=mistral.mistral-large-3-675b-instruct

# Optional Amazon Bedrock Guardrail. Create yours with:  python scripts/create_guardrail.py
# Leave these empty and the app works without a guardrail.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
